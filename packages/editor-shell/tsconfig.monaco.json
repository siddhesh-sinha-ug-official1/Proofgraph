{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "demo/**/*.ts", "demo/**/*.tsx", "test/stub/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "demo-dist",
    "test/stub/harness.ts",
    "test/stub/assert-probes.ts"
  ]
}
